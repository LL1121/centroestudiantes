# ================================================================
# Producción — Centro de Estudiantes (Caddy + proxy_net + postgres_core)
# Copiá como `.env` en la raíz del monorepo.
# ================================================================

# --- Postgres central (contenedor postgres_core en proxy_net) ---
# Crear user/DB una vez con: docker/db/init-postgres-core.sql
DB_USER=centro_app
DB_PASSWORD=cambia-esta-pass-segura
DB_NAME=centro_estudiantes

# SQLAlchemy/asyncpg: el backend convierte postgresql:// → postgresql+asyncpg://
# (?schema=public se ignora; es estilo Prisma)
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@postgres_core:5432/${DB_NAME}?schema=public

# --- Auth ---
# Mínimo 32 caracteres
JWT_SECRET=cambia-este-secreto-largo-en-produccion-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- URLs públicas (HTTPS vía Caddy) ---
PUBLIC_APP_URL=https://biblioteca.tudominio.com
CORS_ORIGINS=https://biblioteca.tudominio.com,https://votacion.tudominio.com,https://landing.tudominio.com
NEXT_PUBLIC_BIBLIOTECA_URL=https://biblioteca.tudominio.com

# --- Biblioteca (frontend) ---
COPYRIGHT_ENABLED=false
NEXT_PUBLIC_COPYRIGHT_ENABLED=false

# --- Embeddings ---
# fake | openai | gemini
EMBEDDING_BACKEND=gemini
EMBEDDING_MODEL=gemini-embedding-001
OPENAI_API_KEY=

# --- Chunking / OCR / fuzzy ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
OCR_LANGS=spa+eng
OCR_MAX_PAGES=50
OCR_MIN_NATIVE_CHARS=200
OCR_DPI=200
FUZZY_THRESHOLD=0.2

# --- LLM (asistente biblioteca) ---
# fake | openai | groq | gemini
LLM_BACKEND=gemini
LLM_MODEL=gemini-2.5-flash-latest
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=8192
LLM_TOP_K=5
CHAT_RATE_LIMIT=30/day
CHAT_RELEVANCE_ENABLED=false
CHAT_RELEVANCE_MAX_DISTANCE=0.75
GROQ_API_KEY=
GEMINI_API_KEY=

# --- Moderación / email / seguridad ---
MODERATION_ENABLED=true
MODERATION_MAX_PAGES=20
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
REQUIRE_EMAIL_VERIFIED=false
ANTIVIRUS_ENABLED=false
UPLOAD_MAX_BYTES=52428800
COPYRIGHT_ENFORCEMENT_ENABLED=false
